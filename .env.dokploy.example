# Copy values into Dokploy → Environment (mark secrets with the lock icon).
# Domains: api.tafakkur.org (api:3000), lms.tafakkur.org (frontend:3000)

# Postgres
POSTGRES_USER=lms
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=lms_production

# Rails
SECRET_KEY_BASE=generate_with_openssl_rand_hex_64
JWT_SECRET=generate_with_openssl_rand_hex_32

# Frontend auth
BETTER_AUTH_SECRET=generate_with_openssl_rand_hex_32

# Email (optional until configured)
RESEND_API_KEY=
MAILER_FROM=noreply@tafakkur.org
