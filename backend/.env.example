# Database (Docker Postgres is mapped to host port 5433)

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=lms
DB_PASSWORD=lms_dev_password

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=dev_jwt_secret_change_in_production

# CORS
FRONTEND_URL=http://localhost:3000

# Email
RESEND_API_KEY=
MAILER_FROM=noreply@tafakkur.local

# Production / Dokploy (see docker-compose.dokploy.yml and .env.dokploy.example):
# DATABASE_URL=postgres://lms:password@db:5432/lms_production
# SECRET_KEY_BASE=generate_with_openssl_rand_hex_64
# JWT_SECRET=generate_with_openssl_rand_hex_32
# FRONTEND_URL=https://lms.tafakkur.org
# MAILER_FROM=noreply@tafakkur.org
